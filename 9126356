------------------------------------------------------------------
RunSection(function()
	local HitboxOn = false
	local Range = 7
	local Transparency = 0.7

	local Tracked = {}
	local LastSync = 0

	local function Restore(Root)
		local Data = Tracked[Root]

		if not Data then
			return
		end

		Tracked[Root] = nil

		for _, C in ipairs(Data.Conns) do
			C:Disconnect()
		end

		if Root.Parent then
			pcall(function()
				Root.Size = Data.Size
				Root.Transparency = Data.Transparency
				Root.Color = Data.Color
				Root.Material = Data.Material
				Root.CanCollide = Data.CanCollide
			end)
		end
	end

	local function Shape(Root)
		local Target = Vector3.new(Range, Range, Range)

		if Root.Size ~= Target then
			Root.Size = Target
		end

		Root.Transparency = Transparency
		Root.CanCollide = false
	end

	local function Track(Root)
		if Tracked[Root] then
			return
		end

		local Data = {
			Size = Root.Size,
			Transparency = Root.Transparency,
			Color = Root.Color,
			Material = Root.Material,
			CanCollide = Root.CanCollide,
			Conns = {},
		}

		Tracked[Root] = Data

		Root.Color = Color3.new(0, 0, 0)
		Root.Material = Enum.Material.SmoothPlastic

		table.insert(Data.Conns, Root:GetPropertyChangedSignal("Size"):Connect(function()
			if HitboxOn then
				local Target = Vector3.new(Range, Range, Range)

				if Root.Size ~= Target then
					Root.Size = Target
				end
			end
		end))

		Shape(Root)
	end

	local function GetTargets()
		local List = {}
		local Seen = {}
		local MyCharacter = LocalPlayer.Character

		local function Add(Model)
			if not Model or Model == MyCharacter or not Model:IsA("Model") then
				return
			end

			local Root = Model:FindFirstChild("HumanoidRootPart")

			if Root and Root:IsA("BasePart") and not Seen[Root] and Model:FindFirstChildOfClass("Humanoid") then
				Seen[Root] = true
				List[#List + 1] = Root
			end
		end

		for _, Player in ipairs(Players:GetPlayers()) do
			if Player ~= LocalPlayer then
				Add(Player.Character)
			end
		end

		local Live = workspace:FindFirstChild("Live")

		if Live then
			for _, Child in ipairs(Live:GetChildren()) do
				Add(Child)
			end
		end

		for _, Child in ipairs(workspace:GetChildren()) do
			Add(Child)
		end

		return List
	end

	local function Sync()
		local Present = {}

		for _, Root in ipairs(GetTargets()) do
			local Humanoid = Root.Parent and Root.Parent:FindFirstChildOfClass("Humanoid")

			if Humanoid and Humanoid.Health > 0 then
				Present[Root] = true
				Track(Root)
			end
		end

		for Root in pairs(Tracked) do
			if not Present[Root] or not Root.Parent then
				Restore(Root)
			end
		end
	end

	local function RestoreAll()
		for Root in pairs(Tracked) do
			Restore(Root)
		end
	end

	local ReachTable
	local ReachOriginal = {}
	local ReachSearched = false

	local function FindReach()
		if ReachSearched then
			return ReachTable
		end

		ReachSearched = true

		pcall(function()
			for _, Inst in ipairs(ReplicatedStorage:GetDescendants()) do
				if Inst:IsA("ModuleScript") and Inst.Name == "Config" then
					local Ok, Result = pcall(require, Inst)

					if Ok and type(Result) == "table"
						and type(Result.Combat) == "table"
						and type(Result.Combat.Reach) == "table" then

						ReachTable = Result.Combat.Reach

						for Key, Value in pairs(ReachTable) do
							if type(Value) == "number" then
								ReachOriginal[Key] = Value
							end
						end

						return
					end
				end
			end
		end)

		return ReachTable
	end

	local function ApplyReach()
		local Reach = FindReach()

		if not Reach then
			return
		end

		local Factor = math.max(Range / (ReachOriginal.Bare or 7), 1)

		pcall(function()
			for Key, Value in pairs(ReachOriginal) do
				Reach[Key] = Value * Factor
			end
		end)
	end

	local function RestoreReach()
		if not ReachTable then
			return
		end

		pcall(function()
			for Key, Value in pairs(ReachOriginal) do
				ReachTable[Key] = Value
			end
		end)
	end

	Conn(RunService.Stepped:Connect(function()
		if not HitboxOn then
			return
		end

		local Now = os.clock()

		if Now - LastSync >= 0.25 then
			LastSync = Now
			Sync()
		end

		for Root in pairs(Tracked) do
			if Root.Parent then
				Shape(Root)
			end
		end
	end))

	OnCleanup(function()
		HitboxOn = false
		RestoreAll()
		RestoreReach()
	end)

	local HitboxToggle = CreateToggle(CombatPage, "Hitbox", false, function(State)
		HitboxOn = State

		if State then
			Sync()
			ApplyReach()
		else
			RestoreAll()
			RestoreReach()
		end
	end, "Hitbox")
	HitboxToggle.LayoutOrder = 3

	local RangeSlider = CreateSlider(CombatPage, "Range", 1, 15, 0.1, 7, function(Value)
		Range = Value

		if HitboxOn then
			for Root in pairs(Tracked) do
				if Root.Parent then
					Shape(Root)
				end
			end

			ApplyReach()
		end
	end, "HitboxRange")
	RangeSlider.LayoutOrder = 4

	local TransparencySlider = CreateSlider(CombatPage, "Transparency", 0.1, 1, 0.1, 0.7, function(Value)
		Transparency = Value

		for Root in pairs(Tracked) do
			if Root.Parent then
				Root.Transparency = Value
			end
		end
	end, "HitboxTransparency")
	TransparencySlider.LayoutOrder = 5
end)

