------------------------------------------------------------------
-- animation loop (border spin, emblem pulse, snow)
------------------------------------------------------------------
local Clock = 0
local Angle = 0

Conn(RunService.Heartbeat:Connect(function(dt)
	if not UIAlive then
		return
	end

	Clock += dt

	Angle = (Angle + S.BorderSpeed * dt) % 360
	StrokeGradient.Rotation = Angle

	local es = 46 + 4 * (0.5 - 0.5 * math.cos(Clock * 2 * math.pi / 4.4))
	Emblem.Size = UDim2.fromOffset(es, es)

	if S.SnowOn then
		local W = math.max(Main.AbsoluteSize.X, 1)
		local H = Main.AbsoluteSize.Y
		local windPx = S.SnowWind * 40

		for i = 1, math.min(S.SnowCount, MAX_FLAKES) do
			local fl = Flakes[i]
			fl.y += fl.vy * S.SnowSpeed * dt
			fl.x += (windPx * fl.sz / W) * dt

			if fl.y > H + 6 then
				fl.y = -6
				fl.x = math.random()
			end

			if fl.x > 1.05 then
				fl.x = -0.05
			elseif fl.x < -0.05 then
				fl.x = 1.05
			end

			fl.f.Position = UDim2.new(fl.x, math.sin(Clock * fl.fq + fl.ph) * fl.am, 0, fl.y)
		end
	end
end))

