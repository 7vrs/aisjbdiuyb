local ActiveSlider = nil
local FeatureControls = {}

local function MakeSlider(Parent, Text, Min, Max, Step, Get, Set, After, Boxed)
	local Pad = Boxed and 9 or 0
	local Top = Boxed and 6 or 0

	local Row = New("Frame", {
		Size = UDim2.new(1, Boxed and -2 or 0, 0, Boxed and 50 or 38),
		BackgroundColor3 = ROW_BG,
		BackgroundTransparency = Boxed and ROW_TRANSP or 1,
		BorderSizePixel = 0,
	}, Parent)

	if Boxed then
		Corner(Row, UDim.new(0, 8))
	end

	New("TextLabel", {
		Size = UDim2.new(1, -(Pad * 2 + 54), 0, 16),
		Position = UDim2.new(0, Pad, 0, Top),
		BackgroundTransparency = 1,
		Text = Text,
		TextColor3 = Boxed and WHITE or DIM,
		Font = Enum.Font.GothamMedium,
		TextSize = Boxed and 12 or 11,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Row)

	local Val = New("TextLabel", {
		Size = UDim2.new(0, 54, 0, 16),
		Position = UDim2.new(1, -(Pad + 54), 0, Top),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = WHITE,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, Row)

	local Track = New("Frame", {
		Size = UDim2.new(1, -(Pad * 2), 0, 6),
		Position = UDim2.new(0, Pad, 0, Top + 24),
		BackgroundColor3 = CONTROL,
		BorderSizePixel = 0,
	}, Row)
	Corner(Track, UDim.new(1, 0))

	local Fill = New("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, Track)
	Corner(Fill, UDim.new(1, 0))
	local FillGradient = New("UIGradient", {}, Fill)

	local Knob = New("Frame", {
		Size = UDim2.new(0, 12, 0, 12),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, Track)
	Corner(Knob, UDim.new(1, 0))

	local Hit = New("TextButton", {
		Size = UDim2.new(1, -(Pad * 2), 0, 24),
		Position = UDim2.new(0, Pad, 0, Top + 15),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 2,
	}, Row)

	local Decimals = 0
	if Step < 1 then Decimals = 1 end
	if Step < 0.1 then Decimals = 2 end
	if Step < 0.01 then Decimals = 3 end

	local function Show(v)
		if math.abs(v) < 1e-9 then
			v = 0
		end

		local f = math.clamp((v - Min) / (Max - Min), 0, 1)
		Fill.Size = UDim2.new(f, 0, 1, 0)
		Knob.Position = UDim2.new(f, 0, 0.5, 0)
		Val.Text = string.format("%." .. Decimals .. "f", v)
	end

	Hit.InputBegan:Connect(function(Input)
		if IsPress(Input) then
			ActiveSlider = function(x)
				local rel = math.clamp((x - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
				local v = Min + (Max - Min) * rel
				local Steps = math.floor((v - Min) / Step + 0.5)
				v = math.clamp(Min + Steps * Step, Min, Max)
				v = math.floor(v * 1000 + 0.5) / 1000

				Set(v)
				Show(v)

				if After then
					After()
				end
			end

			ActiveSlider(Input.Position.X)
		end
	end)

	table.insert(Refreshers, function()
		FillGradient.Color = ColorSequence.new(S.A1, S.A2)
		Show(Get())
	end)

	Show(Get())

	return Row, Show
end

