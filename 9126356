	end

	-- "menu" = visuals, ui + colors (customizer) and the window size
	local function SnapshotMenu()
		local s = {}

		for k, v in pairs(S) do
			s[k] = EncodeValue(v)
		end

		return {
			s = s,
			w = math.floor(Main.AbsoluteSize.X + 0.5),
			h = math.floor(Main.AbsoluteSize.Y + 0.5),
		}
	end

	local function ApplyCombat(t)
		if type(t) ~= "table" then
			return
		end

		for Key, Value in pairs(t) do
			local Control = FeatureControls[Key]

			if Control then
				pcall(Control.Set, Value)
			end
		end
	end

	local Limits = {
		Radius = { 0, 40 },
		BgTheme = { 1, #BgThemes },
		SnowCount = { 0, MAX_FLAKES },
		SnowSpeed = { 0.2, 3 },
		SnowSize = { 1, 8 },
		SnowWind = { -3, 3 },
		BorderThickness = { 0, 6 },
		BorderTransp = { 0, 1 },
		BorderSpeed = { 0, 360 },
		BgTransp = { 0, 0.8 },
		PanelTransp = { 0, 1 },
	}

	local Options = {
		Emblem = { Diamond = true, Circle = true, Squircle = true, Square = true },
		SnowColor = { White = true, Ice = true, Accent = true },
		TitleFont = { Gotham = true, Arcade = true, Code = true, SciFi = true },
	}

	local TextMax = { Title = 14, Subtitle = 24, Letter = 2 }

	local function ApplyMenu(t)
		if type(t) ~= "table" then
			return
		end

		if type(t.s) == "table" then
			for k, raw in pairs(t.s) do
				local default = Defaults[k]

				if default ~= nil then
					local v = DecodeValue(raw)

					if typeof(v) == typeof(default) then
						if type(v) == "number" then
							local lim = Limits[k]

							if lim then
								v = math.clamp(v, lim[1], lim[2])
							end

							if k == "BgTheme" or k == "SnowCount" or k == "Radius" then
								v = math.floor(v)
							end
						elseif type(v) == "string" then
							if Options[k] and not Options[k][v] then
								v = nil
							elseif TextMax[k] then
								v = string.sub(v, 1, TextMax[k])
							end
						end

						if v ~= nil then
							S[k] = v
						end
					end
				end
			end
		end

		if type(t.w) == "number" and type(t.h) == "number" then
			Main.Size = UDim2.fromOffset(math.clamp(t.w, MIN_W, MAX_W), math.clamp(t.h, MIN_H, MAX_H))
		end
	end

	----------------------------------------------------------------
