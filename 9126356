------------------------------------------------------------------
-- snow helpers + apply (pushes every customizer setting onto the UI)
------------------------------------------------------------------
local function SnowCol()
	if S.SnowColor == "Ice" then
		return Color3.fromRGB(170, 225, 255)
	elseif S.SnowColor == "Accent" then
		return S.A2
	end

	return Color3.fromRGB(255, 255, 255)
end

local function ApplySnow()
	local col = SnowCol()

	for i, fl in ipairs(Flakes) do
		fl.f.Visible = S.SnowOn and i <= S.SnowCount
		local px = math.max(1, math.floor(S.SnowSize * fl.sz + 0.5))
		fl.f.Size = UDim2.fromOffset(px, px)
		fl.f.BackgroundColor3 = col
	end
end

local function Seq3(a, b, c)
	return ColorSequence.new({ KP(0, a), KP(0.5, b), KP(1, c) })
end

Apply = function()
	StrokeGradient.Color = S.Rainbow and RainbowSeq or Seq3(S.A1, S.A2, S.A3)
	MainStroke.Thickness = S.BorderThickness
	MainStroke.Transparency = S.BorderTransp

	Glow.Visible = S.Glow
	GlowGradient.Color = ColorSequence.new(S.A1, S.A2)
	EmblemGradient.Color = ColorSequence.new(S.A1, S.A2)
	DividerGradient.Color = ColorSequence.new(S.A1)

	MainCorner.CornerRadius = UDim.new(0, S.Radius)
	local inner = UDim.new(0, math.clamp(math.floor(S.Radius * 0.7), 0, 22))
	CardCorner.CornerRadius = inner
	RailCorner.CornerRadius = inner

	if S.Emblem == "Diamond" then
		Emblem.Rotation = 45
		EmblemLetter.Rotation = -45
		EmblemCorner.CornerRadius = UDim.new(0, 10)
	elseif S.Emblem == "Circle" then
		Emblem.Rotation = 0
		EmblemLetter.Rotation = 0
		EmblemCorner.CornerRadius = UDim.new(1, 0)
	elseif S.Emblem == "Squircle" then
		Emblem.Rotation = 0
		EmblemLetter.Rotation = 0
		EmblemCorner.CornerRadius = UDim.new(0, 14)
	else
		Emblem.Rotation = 0
		EmblemLetter.Rotation = 0
		EmblemCorner.CornerRadius = UDim.new(0, 2)
	end

	TitleText.Text = S.Title
	TitleText.Font = TitleFonts[S.TitleFont] or Enum.Font.GothamBlack
	SubtitleText.Text = S.Subtitle
	EmblemLetter.Text = S.Letter

	local T = BgThemes[S.BgTheme] or BgThemes[1]
	MainGradient.Color = Seq3(T[1], T[2], T[3])

	if OpenDone then
		Main.BackgroundTransparency = S.BgTransp
	end

	Card.BackgroundTransparency = S.PanelTransp
	Rail.BackgroundTransparency = S.PanelTransp

	local cols = { S.A1, S.A2, S.A3 }

	for i = 1, #Tabs do
		Tabs[i].stroke.Color = cols[((i - 1) % 3) + 1]
		Tabs[i].stroke.Transparency = (i == Selected) and 0 or 0.45
		Tabs[i].dot.BackgroundColor3 = (i == Selected) and CONTROL or PANEL2
	end

	ApplySnow()

	for _, fn in ipairs(Refreshers) do
		fn()
	end
end

