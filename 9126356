-- SECTION: crit boost / easy hit (bottom of combat tab)
------------------------------------------------------------------
RunSection(function()
	local CritOn = false
	local EasyOn = false
	local EasyCount = 1

	local CritDelay = 0
	local EasyDelay = 0
	local EasySpacing = 0
	local HeavyCooldown = 5.5
	local HeavyQuietTime = 1
	local Reach = 7

	local LastM1 = nil
	local LastTime = 0
	local LastHeavyAt = -100
	local EasyBusy = false

	local function NearestTarget()
		local Character = LocalPlayer.Character
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Root then
			return nil
		end

		local BestPart = nil
		local BestDistance = Reach

		local function Check(Model)
			if not Model or Model == Character or not Model:IsA("Model") then
				return
			end

			local TargetRoot = Model:FindFirstChild("HumanoidRootPart")
			local Humanoid = Model:FindFirstChildOfClass("Humanoid")

			if not TargetRoot or not Humanoid or Humanoid.Health <= 0 then
				return
			end

			local Distance = (TargetRoot.Position - Root.Position).Magnitude

			if Distance <= BestDistance then
				BestDistance = Distance
				BestPart = Model:FindFirstChild("UpperTorso") or TargetRoot
			end
		end

		for _, Player in ipairs(Players:GetPlayers()) do
			if Player ~= LocalPlayer then
				Check(Player.Character)
			end
		end

		local Live = workspace:FindFirstChild("Live")

		if Live then
			for _, Child in ipairs(Live:GetChildren()) do
				Check(Child)
			end
		end

		return BestPart
	end

	local function SendHit(Kind, Hand)
		local Active = Modules.AttackState and Modules.AttackState.Active
		local Combat = Modules.Combat

		if not Active or not Combat or not IsAlive() then
			return false
		end

		local Target = NearestTarget()

		if not Target then
			return false
		end

		Active.Seq = (Active.Seq or 0) + 1

		local Seq = Active.Seq
		local Character = LocalPlayer.Character
		local HandPart = Character and (Character:FindFirstChild(Hand) or Character:FindFirstChild("HumanoidRootPart"))

		pcall(function()
			Combat.Swing:Fire(Seq, Kind, Hand)
		end)

		task.wait(0.04)

		if Target.Parent and HandPart then
			pcall(function()
				Combat.HitReport:Fire(Seq, Target, HandPart.Position)
			end)
		end

		return true
	end

	local function FireHeavy()
		if not CritOn or not IsAlive() or not HasFight() then
			return
		end

		local Now = os.clock()

		if Now - LastHeavyAt < HeavyCooldown then
			return
		end

		if not NearestTarget() then
			return
		end

		LastHeavyAt = Now

		local Active = Modules.AttackState and Modules.AttackState.Active

		if Active and (Active.Weaving or Active.Shoving or Active.Slamming or Active.Stomping) then
			return
		end

		task.spawn(function()
			pcall(function()
				Modules.Combat.Sprint:Fire(true)
			end)

			task.wait(0.1)

			pcall(function()
				Modules.Combat.Sprint:Fire(false)
			end)

			task.wait(0.18)

			SendHit("Heavy", "RightHand")
		end)
	end

	local function EasyFire()
		if not EasyOn or EasyBusy then
			return
		end

		EasyBusy = true

		task.spawn(function()
			task.wait(EasyDelay)

			for Index = 1, EasyCount do
				if not EasyOn or not IsAlive() or not HasFight() then
					break
				end

				if os.clock() - LastHeavyAt < HeavyQuietTime then
					break
				end

				SendHit("Attack", "LeftHand")

				if Index < EasyCount then
					task.wait(EasySpacing)
				end
			end

			EasyBusy = false
		end)
	end

	Conn(RunService.Heartbeat:Connect(function()
		if not CritOn and not EasyOn then
			LastM1 = nil
			return
		end

		local Active = Modules.AttackState and Modules.AttackState.Active
		local M1 = Active and Active.CurrentM1
		local Playing = false
		local TimePosition = 0

		if M1 then
			pcall(function()
				Playing = M1.IsPlaying
				TimePosition = M1.TimePosition
			end)
		end

		local Restarted = Playing and M1 == LastM1 and TimePosition + 0.02 < LastTime
		LastTime = TimePosition

		if Playing and (M1 ~= LastM1 or Restarted) then
			LastM1 = M1

			if CritOn then
				task.delay(CritDelay, FireHeavy)
			end

			if EasyOn then
				EasyFire()
			end
		elseif not Playing then
			LastM1 = nil
		end
	end))

	local CritToggle = CreateToggle(CombatPage, "Crit Boost", false, function(State)
		CritOn = State
		LastM1 = nil

		if State then
			task.spawn(LoadModules)
		end
	end, "CritBoost")
	CritToggle.LayoutOrder = 13

	local EasyToggle = CreateToggle(CombatPage, "Easy Hit", false, function(State)
		EasyOn = State
		LastM1 = nil

		if State then
			task.spawn(LoadModules)
		end
	end, "EasyHit")
	EasyToggle.LayoutOrder = 14

	local EasySlider = CreateSlider(CombatPage, "Easy Hits", 1, 5, 1, 1, function(Value)
		EasyCount = Value
	end, "EasyHits")
	EasySlider.LayoutOrder = 15
end)

