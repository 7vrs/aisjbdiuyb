	----------------------------------------------------------------
	local function Selected()
		local cfg = SelectedName and Store.configs[SelectedName]

		if not cfg then
			SetStatus("select a config from the list first", false)
			return nil
		end

		return cfg
	end

	local function NewConfigData(risk)
		return { risk = risk, combat = SnapshotCombat(), menu = SnapshotMenu() }
	end

	local function CreateConfig()
		local name = string.match(NameBox.Text, "^%s*(.-)%s*$")

		if name == "" then
			name = "my config"
		end

		name = string.sub(name, 1, 24)

		if Store.configs[name] then
			SetStatus("'" .. name .. "' already exists - pick another name or use Overwrite", false)
			return
		end

		Store.configs[name] = NewConfigData("legit")
		SelectedName = name
		SaveStore()
		RebuildList()
		UpdateControls()
		SetStatus("created '" .. name .. "'", true)
	end

	local function LoadSelected(parts)
		local cfg = Selected()

		if not cfg then
			return
		end

		if parts ~= "menu" then
			ApplyCombat(cfg.combat)
		end

		if parts ~= "combat" then
			ApplyMenu(cfg.menu)
		end

		Apply()

		local what = parts == "combat" and "combat only" or (parts == "menu" and "menu only" or "everything")
		SetStatus("loaded '" .. SelectedName .. "' (" .. what .. ")", true)
	end

	local function OverwriteSelected()
		local cfg = Selected()

		if not cfg then
			return
		end

		cfg.combat = SnapshotCombat()
		cfg.menu = SnapshotMenu()
		SaveStore()
		SetStatus("overwrote '" .. SelectedName .. "' with your current setup", true)
	end

	local function DeleteSelected()
		local cfg = Selected()

		if not cfg then
			return
		end

		if os.clock() - ConfirmDeleteAt > 3 then
			ConfirmDeleteAt = os.clock()
			DeleteButton.Text = "Sure?"

			task.delay(3, function()
				if DeleteButton and DeleteButton.Parent then
					DeleteButton.Text = "Delete"
				end
			end)

			return
		end

		ConfirmDeleteAt = 0
		DeleteButton.Text = "Delete"

		local name = SelectedName
		Store.configs[name] = nil

		if Store.autoload == name then
			Store.autoload = nil
		end

		SelectedName = nil
		SaveStore()
		RebuildList()
		UpdateControls()
		SetStatus("deleted '" .. name .. "'", true)
	end

	local function DuplicateSelected()
		local cfg = Selected()

		if not cfg then
			return
		end

		local Copy = HttpService:JSONDecode(HttpService:JSONEncode(cfg))
		local name = UniqueName(SelectedName .. " copy")

		Store.configs[name] = Copy
		SelectedName = name
		SaveStore()
		RebuildList()
		UpdateControls()
		SetStatus("duplicated as '" .. name .. "'", true)
	end

	local function RefreshListAction()
		LoadStore()

		if SelectedName and not Store.configs[SelectedName] then
			SelectedName = nil
		end

		RebuildList()
		UpdateControls()
		SetStatus("list refreshed", true)
	end

	local function ToggleAutoload()
		if not Selected() then
			return
		end

		if Store.autoload == SelectedName then
			Store.autoload = nil
			SetStatus("autoload off", true)
		else
			Store.autoload = SelectedName
			SetStatus("'" .. SelectedName .. "' will load automatically", true)
		end

		SaveStore()
		RebuildList()
		UpdateControls()
	end

	local function SetRisk(opt)
		local cfg = Selected()

		if not cfg then
			return
		end

		cfg.risk = opt
		SaveStore()
		RebuildList()
		UpdateControls()
	end

	local function CopySelected()
		local cfg = Selected()

		if not cfg then
			return
		end

		local payload = { n = SelectedName, risk = cfg.risk, combat = cfg.combat, menu = cfg.menu }
		local code = CODE_PREFIX .. Base64Encode(HttpService:JSONEncode(payload))
		local copied = false

		if type(setclipboard) == "function" then
			copied = pcall(setclipboard, code)
		elseif type(toclipboard) == "function" then
			copied = pcall(toclipboard, code)
		end

		if copied then
			SetStatus("copied '" .. SelectedName .. "' as a code", true)
		else
			ImportBox.Text = code
			SetStatus("no clipboard access - the code is in the import box, copy it from there", false)
		end
	end

	local function ImportCode()
		local text = string.gsub(ImportBox.Text, "%s+", "")

		if string.sub(text, 1, #CODE_PREFIX) ~= CODE_PREFIX then
			SetStatus("that isn't a valid config code", false)
			return
		end

		local raw = Base64Decode(string.sub(text, #CODE_PREFIX + 1))
		local ok, data = false, nil

		if raw then
			ok, data = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
		end

		if not ok or type(data) ~= "table" or (type(data.combat) ~= "table" and type(data.menu) ~= "table") then
			SetStatus("that code is damaged or not from this script", false)
			return
		end

		local risk = table.find(RISKS, data.risk) and data.risk or "risky"
		local name = UniqueName((type(data.n) == "string" and data.n ~= "") and data.n or "imported")

		Store.configs[name] = {
			risk = risk,
			combat = type(data.combat) == "table" and data.combat or {},
			menu = type(data.menu) == "table" and data.menu or {},
		}

		SelectedName = name
		ImportBox.Text = ""
		SaveStore()
		RebuildList()
		UpdateControls()
		SetStatus("imported as '" .. name .. "'", true)
	end

