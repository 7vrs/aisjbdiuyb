-- SECTION: fling
------------------------------------------------------------------
RunSection(function()
	local AntiFlingOn = false
	local Disabled = setmetatable({}, { __mode = "k" })

	local function RestoreCollisions()
		for Part in pairs(Disabled) do
			Disabled[Part] = nil

			if Part.Parent then
				pcall(function()
					Part.CanCollide = true
				end)
			end
		end
	end

	Conn(RunService.Stepped:Connect(function()
