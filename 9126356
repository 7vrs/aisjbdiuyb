------------------------------------------------------------------
RunSection(function()
	local NoBounceOn = false
	local OriginalGravity = workspace.Gravity
	local BounceUntil = 0
	local StateConn

	local function BindHumanoid(Character)
		if StateConn then
			StateConn:Disconnect()
			StateConn = nil
		end

		local Humanoid = Character and Character:WaitForChild("Humanoid", 5)

		if not Humanoid then
			return
		end

		StateConn = Humanoid.StateChanged:Connect(function(_, New)
			if New == Enum.HumanoidStateType.Landed then
				BounceUntil = os.clock() + 0.25
			elseif New == Enum.HumanoidStateType.Jumping then
				BounceUntil = 0
			end
		end)
	end

	if LocalPlayer.Character then
		task.spawn(BindHumanoid, LocalPlayer.Character)
	end

	Conn(LocalPlayer.CharacterAdded:Connect(function(Character)
		task.spawn(BindHumanoid, Character)
	end))

	Conn(RunService.Heartbeat:Connect(function()
		if not NoBounceOn then
			return
		end

		if workspace.Gravity ~= 700 then
			workspace.Gravity = 700
		end

		if os.clock() >= BounceUntil then
			return
		end

		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Humanoid or not Root then
			return
		end

		if Humanoid.FloorMaterial ~= Enum.Material.Air then
			local Velocity = Root.AssemblyLinearVelocity

			if Velocity.Y > 0 then
				Root.AssemblyLinearVelocity = Vector3.new(Velocity.X, 0, Velocity.Z)
			end
		end
	end))

	OnCleanup(function()
		if NoBounceOn then
			workspace.Gravity = OriginalGravity
		end

		if StateConn then
			StateConn:Disconnect()
		end
	end)

	local NoBounceToggle = CreateToggle(MiscPage, "No Bounce", false, function(State)
		NoBounceOn = State

		if State then
			OriginalGravity = workspace.Gravity
			workspace.Gravity = 700
		else
			workspace.Gravity = OriginalGravity
			BounceUntil = 0
		end
	end, "NoBounce")
	NoBounceToggle.LayoutOrder = 1

	local Spacer = New("Frame", {
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = 2,
	}, MiscPage)

	-- headless
	local HeadlessOn = false
	local HeadOriginal = setmetatable({}, { __mode = "k" })

	local function ApplyHeadless()
		local Character = LocalPlayer.Character
		local Head = Character and Character:FindFirstChild("Head")

		if not Head then
			return
		end

		if HeadlessOn then
			if HeadOriginal[Head] == nil then
				HeadOriginal[Head] = Head.Transparency
			end

			Head.Transparency = 1

			for _, Child in ipairs(Head:GetChildren()) do
				if Child:IsA("Decal") then
					if HeadOriginal[Child] == nil then
						HeadOriginal[Child] = Child.Transparency
					end

					Child.Transparency = 1
				end
			end
		else
			for Inst, Value in pairs(HeadOriginal) do
				if Inst.Parent then
					Inst.Transparency = Value
				end
			end

			table.clear(HeadOriginal)
		end
	end

	Conn(RunService.Heartbeat:Connect(function()
		if HeadlessOn then
			ApplyHeadless()
		end
	end))

	OnCleanup(function()
		HeadlessOn = false
		ApplyHeadless()
	end)

	local HeadlessToggle = CreateToggle(MiscPage, "Headless", false, function(State)
		HeadlessOn = State
		ApplyHeadless()
	end, "Headless")
	HeadlessToggle.LayoutOrder = 3

	-- accessories
	local Show = { Head = true, Hair = true, Face = true, Neck = true }
	local AccessoryOriginal = setmetatable({}, { __mode = "k" })

	local function CategoryOf(Accessory)
		local Type

		pcall(function()
			Type = Accessory.AccessoryType
		end)

		if Type == Enum.AccessoryType.Hat then
			return "Head"
		elseif Type == Enum.AccessoryType.Hair then
			return "Hair"
		elseif Type == Enum.AccessoryType.Face then
			return "Face"
		elseif Type == Enum.AccessoryType.Neck then
			return "Neck"
		end

		local Handle = Accessory:FindFirstChild("Handle")

		if Handle then
			if Handle:FindFirstChild("HairAttachment") then
				return "Hair"
			elseif Handle:FindFirstChild("HatAttachment") then
				return "Head"
			elseif Handle:FindFirstChild("FaceFrontAttachment") or Handle:FindFirstChild("FaceCenterAttachment") then
				return "Face"
			elseif Handle:FindFirstChild("NeckAttachment") then
				return "Neck"
			end
		end

		return nil
	end

	local function SetAccessoryVisible(Accessory, Visible)
		for _, Part in ipairs(Accessory:GetDescendants()) do
			if Part:IsA("BasePart") then
				if Visible then
					local Original = AccessoryOriginal[Part]

					if Original ~= nil then
						Part.Transparency = Original
						AccessoryOriginal[Part] = nil
					end
				else
					if AccessoryOriginal[Part] == nil then
						AccessoryOriginal[Part] = Part.Transparency
					end

					Part.Transparency = 1
				end
			end
		end
	end

	local function ApplyAccessories()
		local Character = LocalPlayer.Character

		if not Character then
			return
		end

		for _, Child in ipairs(Character:GetChildren()) do
			if Child:IsA("Accessory") then
				local Category = CategoryOf(Child)

				if Category then
					SetAccessoryVisible(Child, Show[Category])
				end
			end
		end
	end

	local function WatchCharacter(Character)
		Character.ChildAdded:Connect(function(Child)
			if Child:IsA("Accessory") then
				Child:WaitForChild("Handle", 3)
				task.wait()

				local Category = CategoryOf(Child)

				if Category and not Show[Category] then
					SetAccessoryVisible(Child, false)
				end
			end
		end)
	end

	if LocalPlayer.Character then
		WatchCharacter(LocalPlayer.Character)
	end

	Conn(LocalPlayer.CharacterAdded:Connect(function(Character)
		WatchCharacter(Character)

		task.wait(1)
		ApplyAccessories()
	end))

	for Index, Name in ipairs({ "Head", "Hair", "Face", "Neck" }) do
		local AccessoryToggle = CreateToggle(MiscPage, Name, true, function(State)
			Show[Name] = State
			ApplyAccessories()
		end)
		AccessoryToggle.LayoutOrder = 3 + Index
	end

	-- boost fps
	local Lighting = game:GetService("Lighting")
	local BoostOn = false
	local BoostOriginal = setmetatable({}, { __mode = "k" })
	local SavedQuality
	local AddedConns = {}

	local function SetProp(Inst, Prop, Value)
		pcall(function()
			local Saved = BoostOriginal[Inst]

			if not Saved then
				Saved = {}
				BoostOriginal[Inst] = Saved
			end

			if Saved[Prop] == nil then
				Saved[Prop] = Inst[Prop]
			end

			Inst[Prop] = Value
		end)
	end

	local function InCharacter(Inst)
		local Model = Inst:FindFirstAncestorOfClass("Model")
		return Model ~= nil and Model:FindFirstChildOfClass("Humanoid") ~= nil
	end

	local function Reduce(Inst)
		if Inst:IsA("Terrain") then
			return
		end

		if Inst:IsA("BasePart") then
			SetProp(Inst, "Material", Enum.Material.SmoothPlastic)
			SetProp(Inst, "Reflectance", 0)
			SetProp(Inst, "CastShadow", false)
		elseif Inst:IsA("ParticleEmitter")
			or Inst:IsA("Trail")
			or Inst:IsA("Smoke")
			or Inst:IsA("Fire")
			or Inst:IsA("Sparkles")
			or Inst:IsA("PostEffect")
			or Inst:IsA("Clouds") then
			SetProp(Inst, "Enabled", false)
		elseif Inst:IsA("Decal") then
			if not InCharacter(Inst) then
				SetProp(Inst, "Transparency", 1)
			end
		elseif Inst:IsA("Atmosphere") then
			SetProp(Inst, "Density", 0)
			SetProp(Inst, "Haze", 0)
		end
	end

	local function EnableBoost()
		pcall(function()
			SavedQuality = settings().Rendering.QualityLevel
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)

		SetProp(Lighting, "GlobalShadows", false)
		SetProp(Lighting, "ShadowSoftness", 0)
		SetProp(Lighting, "EnvironmentDiffuseScale", 0)
		SetProp(Lighting, "EnvironmentSpecularScale", 0)

		local Terrain = workspace:FindFirstChildOfClass("Terrain")

		if Terrain then
			SetProp(Terrain, "WaterWaveSize", 0)
			SetProp(Terrain, "WaterWaveSpeed", 0)
			SetProp(Terrain, "WaterReflectance", 0)
			SetProp(Terrain, "Decoration", false)
		end

		for _, Inst in ipairs(Lighting:GetDescendants()) do
			Reduce(Inst)
		end

		table.insert(AddedConns, Lighting.DescendantAdded:Connect(function(Inst)
			if BoostOn then
				Reduce(Inst)
			end
		end))

		table.insert(AddedConns, workspace.DescendantAdded:Connect(function(Inst)
			if BoostOn then
				Reduce(Inst)
			end
		end))

		task.spawn(function()
			local Count = 0

			for _, Inst in ipairs(workspace:GetDescendants()) do
				if not BoostOn then
					return
				end

				Reduce(Inst)
				Count += 1

				if Count % 400 == 0 then
					task.wait()
				end
			end
		end)
	end

	local function DisableBoost()
		for _, C in ipairs(AddedConns) do
			C:Disconnect()
		end

		table.clear(AddedConns)

		for Inst, Props in pairs(BoostOriginal) do
			for Prop, Value in pairs(Props) do
				pcall(function()
					Inst[Prop] = Value
				end)
			end
		end

		table.clear(BoostOriginal)

		if SavedQuality then
			pcall(function()
				settings().Rendering.QualityLevel = SavedQuality
			end)
		end
	end

	OnCleanup(function()
		BoostOn = false
		DisableBoost()
	end)

	local BoostGap = New("Frame", {
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = 8,
	}, MiscPage)

	local BoostToggle = CreateToggle(MiscPage, "Boost Fps", false, function(State)
		BoostOn = State

		if State then
			EnableBoost()
		else
			DisableBoost()
		end
	end, "BoostFps")
	BoostToggle.LayoutOrder = 9
	BoostToggle.BackgroundColor3 = Color3.fromRGB(28, 78, 44)
	BoostToggle.BackgroundTransparency = 0.15
	New("UIStroke", { Color = Color3.fromRGB(70, 150, 90), Thickness = 1, Transparency = 0.4 }, BoostToggle)
end)

