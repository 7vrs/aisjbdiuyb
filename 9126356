	local BAD = Color3.fromRGB(230, 110, 110)

	local Store = { autoload = nil, configs = {} }
	local SelectedName = nil
	local ConfirmDeleteAt = 0

	----------------------------------------------------------------
	-- base64 (for shareable codes)
	----------------------------------------------------------------
	local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

	local function Base64Encode(data)
		local out = {}

		for i = 1, #data, 3 do
			local a, b, c = string.byte(data, i, i + 2)
			local n = a * 65536 + (b or 0) * 256 + (c or 0)
			local i1 = math.floor(n / 262144) % 64
			local i2 = math.floor(n / 4096) % 64
			local i3 = math.floor(n / 64) % 64
			local i4 = n % 64

			out[#out + 1] = string.sub(B64, i1 + 1, i1 + 1)
				.. string.sub(B64, i2 + 1, i2 + 1)
				.. (b and string.sub(B64, i3 + 1, i3 + 1) or "=")
				.. (c and string.sub(B64, i4 + 1, i4 + 1) or "=")
		end

		return table.concat(out)
	end

	local function B64Value(ch)
		if ch == "" or ch == "=" then
			return nil
		end

		local p = string.find(B64, ch, 1, true)
		return p and (p - 1) or nil
	end

	local function Base64Decode(data)
		data = string.gsub(data, "[^%w%+/=]", "")

		local out = {}

		for i = 1, #data, 4 do
			local v1 = B64Value(string.sub(data, i, i))
			local v2 = B64Value(string.sub(data, i + 1, i + 1))
			local v3 = B64Value(string.sub(data, i + 2, i + 2))
			local v4 = B64Value(string.sub(data, i + 3, i + 3))

			if not v1 or not v2 then
				return nil
			end

			local n = v1 * 262144 + v2 * 4096 + (v3 or 0) * 64 + (v4 or 0)

			out[#out + 1] = string.char(math.floor(n / 65536) % 256)
				.. (v3 and string.char(math.floor(n / 256) % 256) or "")
				.. (v4 and string.char(n % 256) or "")
		end

		return table.concat(out)
	end

	----------------------------------------------------------------
	-- snapshot / apply
	----------------------------------------------------------------
	local function EncodeValue(v)
		if typeof(v) == "Color3" then
			return {
				__color = true,
				r = math.floor(v.R * 255 + 0.5),
				g = math.floor(v.G * 255 + 0.5),
				b = math.floor(v.B * 255 + 0.5),
			}
		end

		return v
	end

	local function DecodeValue(v)
		if type(v) == "table" and v.__color then
			return Color3.fromRGB(tonumber(v.r) or 255, tonumber(v.g) or 255, tonumber(v.b) or 255)
		end

		return v
	end

	-- "combat" = every feature toggle / slider
	local function SnapshotCombat()
		local t = {}

		for Key, Control in pairs(FeatureControls) do
