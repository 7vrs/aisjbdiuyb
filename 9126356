-- game modules (shared by weave / combat sections)
------------------------------------------------------------------
local Modules = {}

local function LoadModules()
	if Modules.Weave and Modules.AttackState and Modules.Combat then
		return true
	end

	local Ok, Err = pcall(function()
		local Client = ReplicatedStorage:WaitForChild("Client", 10)
		local Shared = ReplicatedStorage:WaitForChild("Shared", 10)

		Modules.Weave = require(Client.Combat.Weave)
		Modules.AttackState = require(Client.Combat.AttackState)
		Modules.Remotes = require(Shared.Net.Remotes)
		Modules.Movers = require(Shared.Util.Movers)
		Modules.Combat = Modules.Remotes.Client("CombatService")
	end)

	if not Ok then
		warn("[Isaev] could not load the game's modules: " .. tostring(Err))
	end

	if not Modules.Input then
		pcall(function()
			local Client = ReplicatedStorage:WaitForChild("Client", 10)
			Modules.Input = require(Client.Controllers.InputController)
		end)
	end

	return Modules.Weave ~= nil and Modules.AttackState ~= nil and Modules.Combat ~= nil
end

task.spawn(LoadModules)

local function HasFight()
	local Character = LocalPlayer.Character
	return Character ~= nil and Character:FindFirstChild("Fight") ~= nil
end

local function IsAlive()
	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	return Humanoid ~= nil and Humanoid.Health > 0
end

