		Size = UDim2.new(0, 14, 0, 14),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, Switch)
	Corner(Knob, UDim.new(1, 0))

	local Enabled = Initial
	local LastShown = nil

	local function Refresh()
		if Locked then
			Switch.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			Knob.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
		else
			Switch.BackgroundColor3 = Enabled and S.A1 or OFF
			Knob.BackgroundColor3 = Enabled and BLACK or WHITE
		end

		local Pos = Enabled and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)

		if LastShown == nil then
			Knob.Position = Pos
		elseif LastShown ~= Enabled then
			TweenService:Create(Knob, TweenInfo.new(0.15), { Position = Pos }):Play()
		end

		LastShown = Enabled
	end

	Switch.MouseButton1Click:Connect(function()
		if Locked then
			return
		end

		Enabled = not Enabled
		Refresh()

		if Key then
			Config[Key] = Enabled
			SaveConfig()
		end

		if Callback then
			Callback(Enabled)
		end
	end)

	table.insert(Refreshers, Refresh)
	Refresh()

	if Key and not Locked then
		FeatureControls[Key] = {
			Get = function()
				return Enabled
			end,
			Set = function(Value)
				Value = Value == true

				if Value == Enabled then
					return
				end

				Enabled = Value
				Refresh()
				Config[Key] = Enabled
				SaveConfig()

				if Callback then
					Callback(Enabled)
				end
			end,
		}
	end

	if Initial ~= Default and Callback then
		task.defer(Callback, Initial)
	end

	return Holder
end

-- feature slider (saved in config, runs a callback)
local function CreateSlider(Parent, Text, Min, Max, Step, Default, Callback, Key)
	if Key and type(Config[Key]) == "number" then
		Default = math.clamp(Config[Key], Min, Max)
	end

	local Value = Default

	local Row, Show = MakeSlider(Parent, Text, Min, Max, Step, function()
		return Value
	end, function(v)
		Value = v

		if Key then
			Config[Key] = v
			SaveConfig()
		end

		if Callback then
			Callback(v)
		end
	end, nil, true)

	if Callback then
		Callback(Value)
	end

	if Key then
		FeatureControls[Key] = {
			Get = function()
				return Value
			end,
			Set = function(v)
				v = math.clamp(v, Min, Max)
				local Steps = math.floor((v - Min) / Step + 0.5)
				v = math.clamp(Min + Steps * Step, Min, Max)
				v = math.floor(v * 1000 + 0.5) / 1000

				Value = v
				Config[Key] = v
				SaveConfig()

				if Callback then
					Callback(v)
				end

				Show(v)
			end,
		}
	end

	return Row
end

