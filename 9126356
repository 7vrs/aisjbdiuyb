	----------------------------------------------------------------
	local function LoadStore()
		pcall(function()
			if type(isfile) == "function" and type(readfile) == "function" and isfile(CONFIGS_FILE) then
				local decoded = HttpService:JSONDecode(readfile(CONFIGS_FILE))

				if type(decoded) == "table" and type(decoded.configs) == "table" then
					Store = { autoload = decoded.autoload, configs = decoded.configs }
				end
			end
		end)

		if type(Store.autoload) ~= "string" then
			Store.autoload = nil
		end
	end

	local function SaveStore()
		pcall(function()
			if type(writefile) == "function" then
				writefile(CONFIGS_FILE, HttpService:JSONEncode({
					autoload = Store.autoload,
					configs = Store.configs,
				}))
			end
		end)
	end

	local function SortedNames()
		local names = {}

		for name in pairs(Store.configs) do
			table.insert(names, name)
		end

		table.sort(names, function(a, b)
			return string.lower(a) < string.lower(b)
		end)

		return names
	end

	local function UniqueName(base)
		base = string.sub(base, 1, 24)

		if Store.configs[base] == nil then
			return base
		end

		local i = 2

		while Store.configs[base .. " " .. i] ~= nil do
			i += 1
		end

		return base .. " " .. i
	end

