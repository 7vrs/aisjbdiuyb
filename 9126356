-- SECTION: auto connect / no stomp delay / easy stomp
------------------------------------------------------------------
RunSection(function()
	-- Auto Connect normally reuses the game's own swing number for the hit.
	-- If hits don't register on your end, set this to true: it sends its own
	-- swing + hit instead (same method as the Easy Hit feature).
	local USE_OWN_SWING = false

	local ConnectOn = false
	local ConnectRange = 8

	local NoStompOn = false
	local StompGap = 0

	local EasyStompOn = false
	local EasyStompCount = 1
	local EasyStompReach = 7

	local LastLoadTry = 0

	local function EnsureModules()
		if Modules.AttackState and Modules.Combat then
			return true
		end

		local Now = os.clock()

		if Now - LastLoadTry > 2 then
			LastLoadTry = Now
			task.spawn(LoadModules)
		end

		return false
	end

	----------------------------------------------------------------
	-- AUTO CONNECT
	-- When one of your punches or stomps reaches its hit window, the
	-- nearest player inside the range gets hit-reported on that swing,
	-- using whichever hand (or foot, for stomps) is closest to them.
	----------------------------------------------------------------
	local function NearestTarget(Range)
		local Character = LocalPlayer.Character
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Root then
			return nil
		end

		local BestModel = nil
		local BestDistance = Range
		local Seen = {}

		local function Check(Model)
			if not Model or Model == Character or Seen[Model] or not Model:IsA("Model") then
				return
			end

			Seen[Model] = true

			local TargetRoot = Model:FindFirstChild("HumanoidRootPart")
			local Humanoid = Model:FindFirstChildOfClass("Humanoid")

			if not TargetRoot or not Humanoid or Humanoid.Health <= 0 then
				return
			end

			local Distance = (TargetRoot.Position - Root.Position).Magnitude

			if Distance <= BestDistance then
				BestDistance = Distance
				BestModel = Model
			end
		end

		for _, Player in ipairs(Players:GetPlayers()) do
			if Player ~= LocalPlayer then
				Check(Player.Character)
			end
		end

		local Live = workspace:FindFirstChild("Live")

		if Live then
			for _, Child in ipairs(Live:GetChildren()) do
				Check(Child)
			end
		end

		return BestModel
	end

	local HAND_PARTS = { "RightHand", "LeftHand", "Right Arm", "Left Arm" }
	local FOOT_PARTS = { "RightFoot", "LeftFoot", "Right Leg", "Left Leg" }

	local function ClosestLimb(Character, Names, Position)
		local Best = nil
		local BestDistance = math.huge

		for _, Name in ipairs(Names) do
			local Part = Character:FindFirstChild(Name)

			if Part and Part:IsA("BasePart") then
				local Distance = (Part.Position - Position).Magnitude

				if Distance < BestDistance then
					BestDistance = Distance
					Best = Part
				end
			end
		end

		return Best or Character:FindFirstChild("HumanoidRootPart")
	end

	-- Kind is "Attack" (punch) or "Stomp"
	local function ReportHit(Action, Kind)
		local Active = Modules.AttackState and Modules.AttackState.Active
		local Combat = Modules.Combat
		local Character = LocalPlayer.Character

		if not ConnectOn or not Active or not Combat or not Character or not IsAlive() then
			return
		end

		local Current = Kind == "Stomp" and Active.CurrentAction or Active.CurrentM1

		if Current ~= Action then
			return
		end

		local Model = NearestTarget(ConnectRange)

		if not Model then
			return
		end

		local TargetPart = Model:FindFirstChild("UpperTorso")
			or Model:FindFirstChild("Torso")
			or Model:FindFirstChild("HumanoidRootPart")

		if not TargetPart then
			return
		end

		local Limb = ClosestLimb(Character, Kind == "Stomp" and FOOT_PARTS or HAND_PARTS, TargetPart.Position)

		if not Limb then
			return
		end

		local Seq = Active.Seq

		if USE_OWN_SWING then
			Active.Seq = (Active.Seq or 0) + 1
			Seq = Active.Seq

			pcall(function()
				Combat.Swing:Fire(Seq, Kind, Limb.Name == "LeftHand" and "LeftHand" or "RightHand")
			end)

			task.wait(0.04)

			if not TargetPart.Parent then
				return
			end
		end

		if type(Seq) ~= "number" then
			return
		end

		pcall(function()
			Combat.HitReport:Fire(Seq, TargetPart, Limb.Position)
		end)
	end

	local ActionTokens = { Attack = 0, Stomp = 0 }

	local function OnAction(Action, Kind)
		ActionTokens[Kind] += 1

		local Mine = ActionTokens[Kind]
		local Fired = false
		local Marker = nil

		local function Fire()
			if Fired or Mine ~= ActionTokens[Kind] then
				return
			end

			Fired = true

			if Marker then
				Marker:Disconnect()
				Marker = nil
			end

			task.spawn(ReportHit, Action, Kind)
		end

		pcall(function()
			Marker = Action:GetMarkerReachedSignal("Start"):Connect(Fire)
		end)

		task.delay(0.1, Fire)
	end

	local LastM1 = nil
	local LastTime = 0

	Conn(RunService.Heartbeat:Connect(function()
		if not ConnectOn then
			LastM1 = nil
			return
		end

		if not EnsureModules() then
			return
		end

		local Active = Modules.AttackState.Active
		local M1 = Active and Active.CurrentM1

		if not M1 then
			LastM1 = nil
			return
		end

		local Playing = false
		local TimePosition = 0

		pcall(function()
			Playing = M1.IsPlaying
			TimePosition = M1.TimePosition
		end)

		local Restarted = Playing and M1 == LastM1 and TimePosition + 0.02 < LastTime
		LastTime = TimePosition

		if Playing and (M1 ~= LastM1 or Restarted) then
			LastM1 = M1
			OnAction(M1, "Attack")
		elseif not Playing then
			LastM1 = nil
		end
	end))

	----------------------------------------------------------------
	-- EASY STOMP  (same idea as Easy Hit, but for stomps)
	-- When a stomp starts, an extra stomp swing + hit report is sent
	-- on the nearest player inside reach.
	----------------------------------------------------------------
	local EasyStompBusy = false

	local function SendStompHit()
		local Active = Modules.AttackState and Modules.AttackState.Active
		local Combat = Modules.Combat
		local Character = LocalPlayer.Character

		if not Active or not Combat or not Character or not IsAlive() then
			return false
		end

		local Model = NearestTarget(EasyStompReach)

		if not Model then
			return false
		end

		local Target = Model:FindFirstChild("UpperTorso")
			or Model:FindFirstChild("Torso")
			or Model:FindFirstChild("HumanoidRootPart")

		if not Target then
			return false
		end

		local Foot = ClosestLimb(Character, FOOT_PARTS, Target.Position)

		Active.Seq = (Active.Seq or 0) + 1

		local Seq = Active.Seq

		pcall(function()
			Combat.Swing:Fire(Seq, "Stomp", "RightHand")
		end)

		task.wait(0.04)

		if Target.Parent and Foot then
			pcall(function()
				Combat.HitReport:Fire(Seq, Target, Foot.Position)
			end)
		end

		return true
	end

	local function EasyStompFire()
		if not EasyStompOn or EasyStompBusy then
			return
		end

		EasyStompBusy = true

		task.spawn(function()
			task.wait(0)

			for Index = 1, EasyStompCount do
				if not EasyStompOn or not IsAlive() or not HasFight() then
					break
				end

				SendStompHit()

				if Index < EasyStompCount then
					task.wait(0)
				end
			end

			EasyStompBusy = false
		end)
	end

	----------------------------------------------------------------
	-- stomp watcher: drives Auto Connect (stomps), Easy Stomp and
	-- NO STOMP DELAY.
	-- No Stomp Delay frees the stomp lock the moment a stomp starts
	-- (after Stomp Gap, which is 0 by default) and keeps it free
	-- while the animation plays, so you can stomp again instantly.
	-- The animation itself is not cancelled.
	----------------------------------------------------------------
	local LastStomping = false
	local StompStartedAt = 0

	Conn(RunService.Heartbeat:Connect(function()
		if not NoStompOn and not ConnectOn and not EasyStompOn then
			LastStomping = false
			return
		end

		local AttackState = Modules.AttackState

		if not AttackState then
			EnsureModules()
			return
		end

		local Active = AttackState.Active

		if not Active then
			return
		end

		local Now = os.clock()
		local Stomping = Active.Stomping == true
		local Started = Stomping and not LastStomping
		LastStomping = Stomping

		if Started and Active.CurrentKind == "Stomp" and Active.CurrentAction then
			StompStartedAt = Now

			if ConnectOn then
				OnAction(Active.CurrentAction, "Stomp")
			end

			if EasyStompOn then
				EasyStompFire()
			end
		end

		if NoStompOn and Active.CurrentKind == "Stomp" and Now - StompStartedAt >= StompGap then
			local Track = Active.CurrentAction
			local Playing = false

			if Track then
				pcall(function()
					Playing = Track.IsPlaying
				end)
			end

			if Playing then
				Active.CanAttack = true
				Active.Stomping = false
			end
		end
	end))

	----------------------------------------------------------------
	-- controls (combat tab)
	----------------------------------------------------------------
	local ConnectToggle = CreateToggle(CombatPage, "Auto Connect", false, function(State)
		ConnectOn = State

		if State then
			task.spawn(LoadModules)
		end
	end, "AutoConnect")
	ConnectToggle.LayoutOrder = 1

	local ConnectSlider = CreateSlider(CombatPage, "Connect Range", 2, 25, 0.5, 8, function(Value)
		ConnectRange = Value
	end, "ConnectRange")
	ConnectSlider.LayoutOrder = 2

	local NoStompToggle = CreateToggle(CombatPage, "No Stomp Delay", false, function(State)
		NoStompOn = State

		if State then
			task.spawn(LoadModules)
		end
	end, "NoStompDelay")
	NoStompToggle.LayoutOrder = 8

	local StompGapSlider = CreateSlider(CombatPage, "Stomp Gap", 0, 1, 0.01, 0, function(Value)
		StompGap = Value
	end, "StompGap")
	StompGapSlider.LayoutOrder = 9

	local EasyStompToggle = CreateToggle(CombatPage, "Easy Stomp", false, function(State)
		EasyStompOn = State

		if State then
			task.spawn(LoadModules)
		end
	end, "EasyStomp")
	EasyStompToggle.LayoutOrder = 16

	local EasyStompSlider = CreateSlider(CombatPage, "Easy Stomps", 1, 5, 1, 1, function(Value)
		EasyStompCount = Value
	end, "EasyStomps")
	EasyStompSlider.LayoutOrder = 17
end)

