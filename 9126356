RunSection(function()
	local NoDelayOn = false
	local PunchGap = 0.1

	local AttackState

	local function LoadAttackState()
		if AttackState then
			return true
		end

		local Ok, Err = pcall(function()
			local Client = ReplicatedStorage:WaitForChild("Client", 10)

			AttackState = require(Client.Combat.AttackState)
		end)

		if not Ok then
			warn("[Isaev] could not load the game's attack module: " .. tostring(Err))
		end

		return AttackState ~= nil
	end

	task.spawn(LoadAttackState)

	-- no attack delay: frees CanAttack after the punch delay, always.
	-- shove / slam / heavy / stomp / weave no longer pause it.
	local LastCanAttack = true
	local LockStartedAt = 0
	local LastLoadTry = 0

	Conn(RunService.Heartbeat:Connect(function()
		if not NoDelayOn then
			LastCanAttack = true
			return
		end

		local Now = os.clock()

		if not AttackState then
			if Now - LastLoadTry > 2 then
				LastLoadTry = Now
				task.spawn(LoadAttackState)
			end

			return
		end

		pcall(function()
			local Active = AttackState.Active

			if not Active then
				LastCanAttack = true
				return
			end

			local CanAttack = Active.CanAttack

			if CanAttack == false and LastCanAttack ~= false then
				LockStartedAt = Now
			end

			LastCanAttack = CanAttack

			if CanAttack ~= false then
				return
			end

			if not IsAlive() then
				return
			end

			if Now - LockStartedAt >= PunchGap then
				Active.CanAttack = true
				LastCanAttack = true
			end
		end)
	end))

	-- anti stun
	local AntiStunOn = false
	local BaseSpeeds = setmetatable({}, { __mode = "k" })

	Conn(RunService.Heartbeat:Connect(function()
		if not AntiStunOn then
			return
		end

		local Active = AttackState and AttackState.Active
		local M1 = Active and Active.CurrentM1

		if not M1 then
			return
		end

		pcall(function()
			if not M1.IsPlaying then
				return
			end

			local Speed = M1.Speed

			if BaseSpeeds[M1] == nil and Speed > 0.2 then
				BaseSpeeds[M1] = Speed
			end

			if Speed > 0 and Speed <= 0.1 then
				M1:AdjustSpeed(BaseSpeeds[M1] or 1)
			end
		end)
	end))

	-- punch / stomp animation speed
	local PUNCH_IDS = {
		"18312333191", "18312335714", "18312338197", "18312340119",
		"17819438450", "17819441388", "17819444004", "17819446225",
	}

	local STOMP_IDS = { "18362264385", "17837722603" }

	local PunchSpeed = 1.7
	local StompSpeed = 1

	local TrackKinds = setmetatable({}, { __mode = "k" })

	local function HasId(Track, Ids)
		local Animation = Track.Animation

		if not Animation then
			return false
		end

		local AnimId = tostring(Animation.AnimationId)

		for _, Id in ipairs(Ids) do
			if string.find(AnimId, Id, 1, true) then
				return true
			end
		end

		return false
	end

	local function KindOf(Track)
		local Cached = TrackKinds[Track]

		if Cached ~= nil then
			return Cached
		end

		local Kind = false

		if HasId(Track, PUNCH_IDS) then
			Kind = "punch"
		elseif HasId(Track, STOMP_IDS) then
			Kind = "stomp"
		end

		TrackKinds[Track] = Kind

		return Kind
	end

	Conn(RunService.Heartbeat:Connect(function()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local Animator = Humanoid and Humanoid:FindFirstChildOfClass("Animator")

		if not Animator then
			return
		end

		for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
			local Kind = KindOf(Track)

			if Kind then
				local Wanted = Kind == "punch" and PunchSpeed or StompSpeed

				if Kind == "punch" or Wanted > 1 then
					local Speed = Track.Speed

					if Speed > 0.1 and math.abs(Speed - Wanted) > 0.02 then
						pcall(function()
							Track:AdjustSpeed(Wanted)
						end)
					end
				end
			end
		end
	end))

	-- controls (combat tab)
	local NoDelayToggle = CreateToggle(CombatPage, "No Attack Delay", false, function(State)
		NoDelayOn = State

		if State then
			task.spawn(LoadAttackState)
		end
	end, "NoAttackDelay")
	NoDelayToggle.LayoutOrder = 6

	local GapSlider = CreateSlider(CombatPage, "Punch Delay", 0, 0.3, 0.01, 0.1, function(Value)
		PunchGap = Value
	end, "PunchGap")
	GapSlider.LayoutOrder = 7

	local AntiStunToggle = CreateToggle(CombatPage, "Anti Stun", false, function(State)
		AntiStunOn = State

		if State then
			task.spawn(LoadAttackState)
		end
	end, "AntiStun")
	AntiStunToggle.LayoutOrder = 10

	local PunchSpeedSlider = CreateSlider(CombatPage, "Punch Speed", 1.2, 5, 0.1, 1.7, function(Value)
		PunchSpeed = Value
	end, "PunchSpeed")
	PunchSpeedSlider.LayoutOrder = 11

	local StompSpeedSlider = CreateSlider(CombatPage, "Stomp Speed", 1, 3, 0.1, 1, function(Value)
		StompSpeed = Value
	end, "StompSpeed")
	StompSpeedSlider.LayoutOrder = 12
end)

