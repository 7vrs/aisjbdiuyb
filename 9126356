-- SECTION: weave
------------------------------------------------------------------
RunSection(function()
	local AutoEnabled = false
	local DashEnabled = false
	local DashDistance = 2.2
	local WeaveSlideOn = false

	local Linger = 0.4
	local AnimSpeed = 0.9
	local WalkSpeedDefault = 11
	local WalkSpeedSetting = 11
	local WalkSpeedOn = false
	local WeaveBusy = false

	local Sources = { Space = false, L2 = false, Game = false }
	local SpaceHeld = false
	local Weaving = false
	local SignalOn = false
	local LingerUntil = nil
	local LastFire = 0

	local Blocked = false
	local OriginalSet
	local OriginalPlay
	local OriginalStop
	local OriginalReset
	local SpaceBound = false

	local function RefreshHeld()
		SpaceHeld = Sources.Space or Sources.L2 or Sources.Game
	end

	local function ClearInputSources()
		Sources.Space = false
		Sources.L2 = false
		Sources.Game = false
		RefreshHeld()
	end

	local function OwnWeaving()
		return Weaving
	end

	local function WalkSpeedCustom()
		return WalkSpeedOn and math.abs(WalkSpeedSetting - WalkSpeedDefault) > 0.01
	end

	local function RestoreWalkSpeed()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if Humanoid and not (AutoEnabled and Weaving) and not WeaveBusy then
			Humanoid.WalkSpeed = WalkSpeedDefault
		end
	end

	local function BlockGameWeave()
		if Blocked or SpaceBound or not Modules.Weave then
			return
		end

		local Weave = Modules.Weave
		local Ok = pcall(function()
			OriginalSet = Weave.Set
			OriginalPlay = Weave.Play
			OriginalStop = Weave.StopTrack
			OriginalReset = Weave.Reset
			Weave.Set = function() end
			Weave.Play = function() end
			Weave.StopTrack = function() end
			Weave.Reset = function() end
		end)

		if Ok and Weave.Set ~= OriginalSet then
			Blocked = true

			if Modules.AttackState and Modules.AttackState.Active then
				Modules.AttackState.Active.Weaving = false
			end
		else
			pcall(function()
				Weave.Set = OriginalSet or Weave.Set
				Weave.Play = OriginalPlay or Weave.Play
				Weave.StopTrack = OriginalStop or Weave.StopTrack
				Weave.Reset = OriginalReset or Weave.Reset
			end)

			SpaceBound = true

			ContextActionService:BindActionAtPriority(
				"IsaevBlockSpace",
				function()
					return Enum.ContextActionResult.Sink
				end,
				false,
				Enum.ContextActionPriority.High.Value + 1,
				Enum.KeyCode.Space
			)
		end
	end

	local function UnblockGameWeave()
		if Blocked and Modules.Weave then
			pcall(function()
				Modules.Weave.Set = OriginalSet
				Modules.Weave.Play = OriginalPlay
				Modules.Weave.StopTrack = OriginalStop
				Modules.Weave.Reset = OriginalReset
			end)
		end

		Blocked = false

		if SpaceBound then
			SpaceBound = false
			ContextActionService:UnbindAction("IsaevBlockSpace")
		end
	end

	local TrackCache = { Character = nil, Style = nil, Weave = nil }

	local function GetWeaveTracks()
		local AttackState = Modules.AttackState
		local Character = LocalPlayer.Character

		if not AttackState or not Character then
			return nil
		end

		local Style

		pcall(function()
			Style = AttackState.StyleName()
		end)

		if TrackCache.Weave and TrackCache.Character == Character and TrackCache.Style == Style then
			return TrackCache.Weave
		end

		local Weave

		pcall(function()
			local Set = AttackState.StyleSet()
			Weave = Set and Set.Weave
		end)

		TrackCache.Character = Character
		TrackCache.Style = Style
		TrackCache.Weave = Weave

		return Weave
	end

	local Offsets = {
		Front = CFrame.new(0, 0, -2.2),
		Back = CFrame.new(0, 0, 2.2),
		Right = CFrame.new(2.2, 0, 0),
		Left = CFrame.new(-2.2, 0, 0),
	}

	local function CurrentDirection()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Humanoid or not Root then
			return nil
		end

		local Move = Humanoid.MoveDirection

		if Move.Magnitude <= 0 then
			return nil
		end

		local Forward = Move:Dot(Root.CFrame.LookVector)
		local Side = Move:Dot(Root.CFrame.RightVector)

		if Forward >= 0.5 then
			return "Front", Root
		elseif Forward <= -0.5 then
			return "Back", Root
		elseif Side >= 0.9 then
			return "Right", Root
		elseif Side <= -0.9 then
			return "Left", Root
		end

		return nil
	end

	local OwnTrack
	local OwnDirection
	local OwnLooped = false
	local LastDashDirection
	local DashBlockedUntil = 0

	local function StopOwnTrack()
		if OwnTrack then
			local Track = OwnTrack

			pcall(function()
				Track.Looped = OwnLooped

				if Track.IsPlaying then
					Track:Stop()
				end
			end)
		end

		OwnTrack = nil
		OwnDirection = nil
	end

	local function Dash(Root, Direction)
		if not DashEnabled then
			return
		end

		local Now = os.clock()

		if Now < DashBlockedUntil or LastDashDirection == Direction then
			return
		end

		local Existing = Root:FindFirstChildOfClass("BodyPosition")

		if Existing then
			Existing:Destroy()
			return
		end

		LastDashDirection = Direction
		DashBlockedUntil = Now + 0.3

		local Way = (Root.CFrame * Offsets[Direction]).Position - Root.Position

		if Way.Magnitude <= 0 then
			return
		end

		local Target = Root.Position + Way.Unit * DashDistance
		local Made = false

		if Modules.Movers then
			Made = pcall(function()
				Modules.Movers.Create("BodyPosition", "WeaveMove", {
					MaxForce = Vector3.new(30000, 0, 30000),
					P = 220,
					D = 0,
					Position = Target,
				}, Root, 0.1)
			end)
		end

		if not Made then
			local Mover = Instance.new("BodyPosition")
			Mover.Name = "WeaveMove"
			Mover.MaxForce = Vector3.new(30000, 0, 30000)
			Mover.P = 220
			Mover.D = 0
			Mover.Position = Target
			Mover.Parent = Root

			task.delay(0.1, function()
				if Mover.Parent then
					Mover:Destroy()
				end
			end)
		end
	end

	local function UpdateWeave()
		local Direction, Root = CurrentDirection()

		if not Direction then
			StopOwnTrack()
			return
		end

		local Tracks = GetWeaveTracks()
		local Track = Tracks and Tracks[Direction]

		if not Track then
			return
		end

		if OwnTrack == Track and Track.IsPlaying then
			pcall(function()
				if math.abs(Track.Speed - AnimSpeed) > 0.01 then
					Track:AdjustSpeed(AnimSpeed)
				end
			end)

			return
		end

		if OwnTrack and OwnTrack ~= Track then
			StopOwnTrack()
		end

		if OwnTrack ~= Track then
			OwnLooped = Track.Looped
			OwnTrack = Track
		end

		Track.Looped = true
		Track:Play(0.1, 1, AnimSpeed)

		if OwnDirection ~= Direction then
			OwnDirection = Direction
			Dash(Root, Direction)
		end
	end

	local PATTERNS = {
		{ Id = "flip24", Kind = "flip", P = 0.24 },
		{ Id = "flip27", Kind = "flip", P = 0.27 },
		{ Id = "flip30", Kind = "flip", P = 0.30 },
		{ Id = "flip33", Kind = "flip", P = 0.33 },
		{ Id = "signal34", Kind = "signal", P = 0.34 },
		{ Id = "signal36", Kind = "signal", P = 0.36 },
	}

	local Pattern = PATTERNS[2]

	for _, Candidate in ipairs(PATTERNS) do
		if Candidate.Id == Config.WeavePatternV2 then
			Pattern = Candidate
		end
	end

	local MIN_SPACING = 0.2
	local RECOVER_AFTER = 0.05
	local RECOVER_SPACING = 0.22
	local FAST_SPACING = 0.10
	local PunchFlipAt = nil
	local LastCanAttackPoll = true

	local FramesOn = false
	local OffSince = nil
	local FramesConn = nil
	local PendingTrueAt = nil

	local function WatchFrames(Character)
		if FramesConn then
			FramesConn:Disconnect()
			FramesConn = nil
		end

		FramesOn = false
		OffSince = os.clock()

		if not Character then
			return
		end

		FramesOn = Character:GetAttribute("WeaveFrames") == true
		OffSince = FramesOn and nil or os.clock()

		FramesConn = Character:GetAttributeChangedSignal("WeaveFrames"):Connect(function()
			FramesOn = Character:GetAttribute("WeaveFrames") == true

			if FramesOn then
				OffSince = nil
			elseif not OffSince then
				OffSince = os.clock()
			end
		end)
	end

	local function FireWeave(State)
		local Combat = Modules.Combat

		if not Combat then
			return
		end

		pcall(function()
			Combat.Weave:Fire(State)
		end)

		if State then
			LastFire = os.clock()
		end
	end

	local function Trigger(Kind)
		if Kind == "flip" then
			FireWeave(false)
			FireWeave(true)
		else
			FireWeave(true)
		end
	end

	local function ServicePending(Now)
		if PendingTrueAt and Now >= PendingTrueAt then
			PendingTrueAt = nil
			FireWeave(true)
		end
	end

	local function StopWeave()
		Weaving = false
		LastDashDirection = nil
		LingerUntil = nil
		PendingTrueAt = nil

		if SignalOn then
			SignalOn = false
			FireWeave(false)
		end

		StopOwnTrack()
	end

	-- unequipping the fist shuts weave off completely
	local ToolConn = nil

	local function WatchTools(Character)
		if ToolConn then
			ToolConn:Disconnect()
			ToolConn = nil
		end

		if not Character then
			return
		end

		ToolConn = Character.ChildRemoved:Connect(function(Child)
			if Child.Name == "Fight" and AutoEnabled then
				ClearInputSources()
				StopWeave()
			end
		end)
	end

	local function Tick()
		if not AutoEnabled or not Modules.Combat then
			return
		end

		local Now = os.clock()

		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local AliveNow = Humanoid ~= nil and Humanoid.Health > 0

		if not AliveNow then
			Weaving = false
			SignalOn = false
			LingerUntil = nil
			PendingTrueAt = nil
			StopOwnTrack()
			return
		end

		if not HasFight() then
			if SpaceHeld or Weaving or SignalOn then
				ClearInputSources()
				StopWeave()
			end

			return
		end

		local CanAttackNow = true

		pcall(function()
			CanAttackNow = Modules.AttackState.Active.CanAttack ~= false
		end)

		if CanAttackNow and not LastCanAttackPoll then
			PunchFlipAt = Now
		end

		LastCanAttackPoll = CanAttackNow

		local Moving = Humanoid.MoveDirection.Magnitude > 0.05

		local WantWeave = SpaceHeld and Moving

		if WantWeave then
			if not Weaving then
				Weaving = true
				LastDashDirection = nil
			end

			if not SignalOn then
				PunchFlipAt = nil
			end

			SignalOn = true
			LingerUntil = nil

			UpdateWeave()
		elseif Weaving then
			Weaving = false
			LastDashDirection = nil
			StopOwnTrack()

			if SignalOn then
				LingerUntil = Now + Linger
			end
		end

		if SignalOn then
			if not WantWeave and LingerUntil and Now >= LingerUntil then
				SignalOn = false
				LingerUntil = nil
				PendingTrueAt = nil
				FireWeave(false)
			else
				ServicePending(Now)

				local Gap = Now - LastFire
				local Send = Gap >= math.max(Pattern.P, MIN_SPACING)

				if not Send and PunchFlipAt and Now >= PunchFlipAt and Gap >= FAST_SPACING then
					PunchFlipAt = nil
					Send = true
				end

				if not Send and not FramesOn and OffSince and Now - OffSince >= RECOVER_AFTER and Gap >= RECOVER_SPACING then
					Send = true
				end

				if Send and not PendingTrueAt then
					Trigger(Pattern.Kind)
				end
			end
		end
	end

	Conn(RunService.Heartbeat:Connect(Tick))

	local InputHooked = false

	local function HookGameInput()
		if InputHooked or not Modules.Input then
			return
		end

		InputHooked = true

		pcall(function()
			Modules.Input.Began:Connect(function(Action)
				if Action == "Weave" and AutoEnabled and HasFight() then
					Sources.Game = true
					RefreshHeld()
					Tick()
				end
			end)

			Modules.Input.Ended:Connect(function(Action)
				if Action == "Weave" then
					Sources.Game = false
					RefreshHeld()
					Tick()
				end
			end)
		end)
	end

	local LockedSpeed
	local MomentumCleared = false

	local function EnforceNoSlide()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if not Humanoid then
			LockedSpeed = nil
			return
		end

		local Running = AutoEnabled and Weaving and HasFight()

		if Running and not WeaveSlideOn then
			if not LockedSpeed and Humanoid.WalkSpeed > 0 then
				LockedSpeed = Humanoid.WalkSpeed
			end

			if LockedSpeed and Humanoid.WalkSpeed ~= 0 then
				Humanoid.WalkSpeed = 0
			end

			if not MomentumCleared then
				MomentumCleared = true

				local Root = Character:FindFirstChild("HumanoidRootPart")

				if Root then
					local Velocity = Root.AssemblyLinearVelocity
					Root.AssemblyLinearVelocity = Vector3.new(0, Velocity.Y, 0)
				end
			end
		else
			MomentumCleared = false

			if LockedSpeed then
				if Humanoid.WalkSpeed == 0 then
					Humanoid.WalkSpeed = WalkSpeedCustom() and WalkSpeedSetting or LockedSpeed
				end

				LockedSpeed = nil
			end
		end
	end

	pcall(function()
		RunService:UnbindFromRenderStep("IsaevNoSlide")
	end)

	RunService:BindToRenderStep("IsaevNoSlide", Enum.RenderPriority.Last.Value, EnforceNoSlide)
	Conn(RunService.Heartbeat:Connect(EnforceNoSlide))

	local function WatchWalkSpeed(Character)
		task.spawn(function()
			local Humanoid = Character:WaitForChild("Humanoid", 10)

			if Humanoid then
				Humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(EnforceNoSlide)
			end
		end)
	end

	if LocalPlayer.Character then
		WatchFrames(LocalPlayer.Character)
		WatchTools(LocalPlayer.Character)
		WatchWalkSpeed(LocalPlayer.Character)
	end

	Conn(LocalPlayer.CharacterAdded:Connect(function(Character)
		WatchFrames(Character)
		WatchTools(Character)
		WatchWalkSpeed(Character)

		TrackCache.Weave = nil
		OwnTrack = nil
		OwnDirection = nil
		LastDashDirection = nil

		Sources.Space = UserInputService:IsKeyDown(Enum.KeyCode.Space)
		Sources.L2 = false
		Sources.Game = false
		RefreshHeld()
	end))

	Conn(RunService.RenderStepped:Connect(function()
		if not WalkSpeedCustom() then
			return
		end

		if (AutoEnabled and Weaving) or WeaveBusy then
			return
		end

		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if Humanoid and Humanoid.Health > 0 and Humanoid.WalkSpeed ~= WalkSpeedSetting then
			Humanoid.WalkSpeed = WalkSpeedSetting
		end
	end))

	Conn(UserInputService.InputBegan:Connect(function(Input)
		if not AutoEnabled then
			return
		end

		if Input.KeyCode == Enum.KeyCode.Space then
			if UserInputService:GetFocusedTextBox() or not HasFight() then
				return
			end

			Sources.Space = true
			RefreshHeld()
			Tick()
		elseif Input.KeyCode == Enum.KeyCode.ButtonL2 then
			if not HasFight() then
				return
			end

			Sources.L2 = true
			RefreshHeld()
			Tick()
		end
	end))

	Conn(UserInputService.InputEnded:Connect(function(Input)
		if Input.KeyCode == Enum.KeyCode.Space then
			Sources.Space = false
			RefreshHeld()
			Tick()
		elseif Input.KeyCode == Enum.KeyCode.ButtonL2 then
			Sources.L2 = false
			RefreshHeld()
			Tick()
		end
	end))

	Conn(UserInputService.WindowFocusReleased:Connect(function()
		ClearInputSources()
	end))

	OnCleanup(function()
		if ToolConn then
			ToolConn:Disconnect()
		end

		if FramesConn then
			FramesConn:Disconnect()
		end

		pcall(function()
			RunService:UnbindFromRenderStep("IsaevNoSlide")
		end)

		AutoEnabled = false
		StopWeave()
		UnblockGameWeave()
	end)

	-- weave-slide system (keeps your speed capped while weaving)
	do
		local WEAVE_IDS = {
			["18312351760"] = true,
			["18312346524"] = true,
			["18312348771"] = true,
			["18312344029"] = true,
			["17819695187"] = true,
			["17819683172"] = true,
			["17819691229"] = true,
			["17819688197"] = true,
		}

		local systemData = {
			Enabled = false,
			WeaveWalkSpeed = 10,
			FallbackWalkSpeed = 11,
			PreWeaveWalkSpeed = 11,
			IsWeaving = false,
		}

		local character
		local humanoid
		local rootPart
		local animator

		local function setupCharacter(newCharacter)
			character = newCharacter
			humanoid = character:WaitForChild("Humanoid")
			rootPart = character:WaitForChild("HumanoidRootPart")
			animator = humanoid:WaitForChild("Animator")

			systemData.IsWeaving = false
			systemData.PreWeaveWalkSpeed = humanoid.WalkSpeed
		end

		if LocalPlayer.Character then
			task.spawn(setupCharacter, LocalPlayer.Character)
		end

		Conn(LocalPlayer.CharacterAdded:Connect(function(newCharacter)
			setupCharacter(newCharacter)
		end))

		local function checkIsWeaving()
			if OwnWeaving() then
				return true
			end

			if not animator then
				return false
			end

			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				if track.IsPlaying and track.Animation then
					local animId = tostring(track.Animation.AnimationId)

					for id in pairs(WEAVE_IDS) do
						if string.find(animId, id, 1, true) then
							return true
						end
					end
				end
			end

			return false
		end

		local function stripDashVelocities()
			if not character or not rootPart then
				return
			end

			for _, child in ipairs(rootPart:GetChildren()) do
				if child:IsA("LinearVelocity")
					or child:IsA("BodyVelocity")
					or child:IsA("VectorForce")
					or child:IsA("BodyThrust") then
					child:Destroy()
				end
			end

			local currentVel = rootPart.AssemblyLinearVelocity
			local horizontalVel = Vector3.new(currentVel.X, 0, currentVel.Z)
			local maxSpeed = systemData.WeaveWalkSpeed + 1

			if horizontalVel.Magnitude > maxSpeed then
				local cappedVel = horizontalVel.Unit * maxSpeed

				rootPart.AssemblyLinearVelocity = Vector3.new(cappedVel.X, currentVel.Y, cappedVel.Z)
			end
		end

		local function forceUnlockMovement()
			if not humanoid or humanoid.Health <= 0 then
				return
			end

			local restoreSpeed = systemData.PreWeaveWalkSpeed

			if WalkSpeedCustom() then
				restoreSpeed = WalkSpeedSetting
			elseif not restoreSpeed
				or restoreSpeed == systemData.WeaveWalkSpeed
				or restoreSpeed > systemData.FallbackWalkSpeed then
				restoreSpeed = systemData.FallbackWalkSpeed
			end

			humanoid.WalkSpeed = restoreSpeed
			humanoid.AutoRotate = true
		end

		Conn(RunService.RenderStepped:Connect(function()
			if not systemData.Enabled
				or not humanoid
				or humanoid.Health <= 0 then
				WeaveBusy = false
				return
			end

			local activeWeave = checkIsWeaving()
			WeaveBusy = activeWeave

			if activeWeave then
				if not systemData.IsWeaving then
					if WalkSpeedCustom() then
						systemData.PreWeaveWalkSpeed = WalkSpeedSetting
					elseif humanoid.WalkSpeed > 0
						and humanoid.WalkSpeed ~= systemData.WeaveWalkSpeed then
						systemData.PreWeaveWalkSpeed = math.min(
							humanoid.WalkSpeed,
							systemData.FallbackWalkSpeed
						)
					end

					systemData.IsWeaving = true
				end

				humanoid.WalkSpeed = systemData.WeaveWalkSpeed
				stripDashVelocities()
			elseif systemData.IsWeaving then
				systemData.IsWeaving = false
				forceUnlockMovement()
			end
		end))

		-- controls (weave tab)
		local AutoToggle = CreateToggle(WeavePage, "Weave", false, function(State)
			AutoEnabled = State

			if State then
				task.spawn(function()
					if LoadModules() and AutoEnabled then
						BlockGameWeave()
					end

					HookGameInput()
				end)
			else
				ClearInputSources()
				StopWeave()
				UnblockGameWeave()
			end
		end, "Weave")
		AutoToggle.LayoutOrder = 1

		local DashToggle = CreateToggle(WeavePage, "Weave Glide", false, function(State)
			DashEnabled = State
		end, "WeaveDash")
		DashToggle.LayoutOrder = 2

		local DashSlider = CreateSlider(WeavePage, "Glide Distance", 0.5, 10, 0.1, 2.2, function(Value)
			DashDistance = Value
		end, "DashDistance")
		DashSlider.LayoutOrder = 3

		local SlideToggle = CreateToggle(WeavePage, "Weave Slide", false, function(State)
			systemData.Enabled = State
			WeaveSlideOn = State

			if not systemData.Enabled then
				systemData.IsWeaving = false
				WeaveBusy = false
				forceUnlockMovement()
			end
		end, "WeaveSlide")
		SlideToggle.LayoutOrder = 4

		local SpeedSlider = CreateSlider(WeavePage, "Weave Speed", 6, 50, 0.1, 10, function(Value)
			systemData.WeaveWalkSpeed = Value
		end, "WeaveSpeed")
		SpeedSlider.LayoutOrder = 5

		local DelaySlider = CreateSlider(WeavePage, "Turn Off Delay", 0, 1, 0.05, 0.4, function(Value)
			Linger = Value
		end, "TurnOffDelay")
		DelaySlider.LayoutOrder = 6

		-- walk speed is OFF every time the script loads
		local WalkToggle = CreateToggle(WeavePage, "Walk Speed", false, function(State)
			local WasCustom = WalkSpeedCustom()
			WalkSpeedOn = State

			if WasCustom and not WalkSpeedCustom() then
				RestoreWalkSpeed()
			end
		end)
		WalkToggle.LayoutOrder = 7

		local WalkSlider = CreateSlider(WeavePage, "Walk Speed Value", 5, 50, 1, 11, function(Value)
			local WasCustom = WalkSpeedCustom()

			WalkSpeedSetting = Value

			if WasCustom and not WalkSpeedCustom() then
				RestoreWalkSpeed()
			end
		end, "WalkSpeed")
		WalkSlider.LayoutOrder = 8
	end
end)

